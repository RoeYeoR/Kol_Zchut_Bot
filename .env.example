# Cohere (required) — powers BOTH embeddings (embed-multilingual-v3.0) and reranking.
# One key runs the whole retrieval side. Free trial key: https://dashboard.cohere.com
COHERE_API_KEY=""

# Anthropic / Claude (required) — writes the grounded, cited answer.
ANTHROPIC_API_KEY=""

# Models / tuning (optional — sensible defaults in app/config.py)
EMBEDDING_MODEL="embed-multilingual-v3.0"
ANSWER_MODEL="claude-sonnet-5"
RERANK_MODEL="rerank-multilingual-v3.0"
