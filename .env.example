# Embeddings (required) — used to vectorize both documents and queries
OPENAI_API_KEY=""

# Answer generation (required) — Claude writes the grounded, cited answer
ANTHROPIC_API_KEY=""

# Reranking (optional) — Cohere Rerank re-sorts retrieved chunks by true relevance.
# Without it, the app falls back to vector-score order and still runs.
COHERE_API_KEY=""

# Models / tuning (optional — sensible defaults in app/config.py)
EMBEDDING_MODEL="text-embedding-3-small"
ANSWER_MODEL="claude-sonnet-5"
RERANK_MODEL="rerank-multilingual-v3.0"
